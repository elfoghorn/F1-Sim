// Cloudflare Workers settings for F1 SIM (used when the site runs as a Worker, at *.workers.dev).
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "f1-sim",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // The website itself: every file in site/ is served as it is.
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // Only the site's own server routes (the Discord relay) run code; everything else is plain files.
    "run_worker_first": ["/api/*"]
  },
  // Keep the variables and secrets set in the dashboard (DISCORD_WEBHOOK and friends) on every deploy.
  "keep_vars": true
}
